{
  "name": "emotix-emotion-recognition",
  "productName": "EmotiX - Emotion Recognition System",
  "version": "1.0.0",
  "description": "EmotiX: Multimodal Emotion Recognition Software (Facial Action Units & Acoustic Prosody)",
  "main": "main.js",
  "author": "Vishwa, Vicky, Subash, Ashwin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "build:portable": "electron-builder --win portable",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.emotix.ai",
    "productName": "EmotiX - Emotion Recognition System",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "ui/static/demo_samples/app_icon.ico"
    },
    "files": [
      "main.js",
      "ui/static/**/*",
      "package.json"
    ]
  }
}
